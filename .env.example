# GEMINI_API_KEY: Required for server-side Gemini Text-to-Speech (/api/tts).
# IMPORTANT: Keep this secret on the server only (do NOT prefix with VITE_).
# On Vercel: Project Settings -> Environment Variables -> Add GEMINI_API_KEY
# On AI Studio: Configured automatically via Settings -> Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional public deployment URL of the web application.
APP_URL="MY_APP_URL"
